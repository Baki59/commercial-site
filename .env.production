# Production environment defaults.
# These are committed to the repo so Vercel always has a valid fallback.
# Override them in the Vercel dashboard with the real production values.

# Set this in Vercel dashboard to the live API URL.
# Example: https://api.sazin.com/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Used for canonical URLs, sitemap.xml and Open Graph tags.
# Must be a valid absolute URL. Override in Vercel dashboard with real domain.
NEXT_PUBLIC_SITE_URL=https://sazin.com

# Analytics
NEXT_PUBLIC_GA_ID=
